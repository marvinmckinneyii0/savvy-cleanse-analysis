# Anthropic (Phase 1 narrative generator)
ANTHROPIC_API_KEY=

# OpenAI fallback (Phase 1 narrative generator)
OPENAI_API_KEY=

# Google (Gemini) fallback (Phase 1 narrative generator)
GEMINI_API_KEY=

# Supabase — UNIFIED single project starting Phase 3 (do NOT commit real keys)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend equivalents (Vite reads VITE_*-prefixed vars)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Formspree form ID for the contact + signup forms (public value, e.g. "xabcdwxyz").
# Without it the forms show an error and point visitors to the support email.
VITE_FORMSPREE_FORM_ID=

# Stripe Payment Link for the refundable reserve-a-spot deposit
# (e.g. "https://buy.stripe.com/abc123"). Create it in your Stripe dashboard.
# Leave empty to hide the "Reserve Your Spot" option.
VITE_STRIPE_PAYMENT_LINK=

# SMTP — Phase 2 alert delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
